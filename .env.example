# QoS Buddy - Environment Variables
# Copy this file to .env and fill in your values

# ── LLM API Keys (at least one required for Agent 1 chatbot) ──
# OpenRouter (preferred) - get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Google Gemini (alternative) - get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Database (SQLite for alerts, users, chat logs — NOT the main dataset) ──
# The main dataset is backend/unified_telecom_dataset_FILLED.csv (loaded automatically)
DATABASE_URL=sqlite:///qos_buddy.db

# ── Feature Flags ──
ENABLE_DB_ALERTS=true
DEV_MODE=false

# ── Authentication (JWT) ──
JWT_SECRET_KEY=change-me-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Scraper / Enrichment ──
SCRAPER_MIN_DELAY_SEC=0.6
TELECOM_RELEVANCE_THRESHOLD=0.35

# ── External Data APIs ──
DATAGOV_CKAN_API=https://catalog.data.gov/api/3/action/package_search
EU_DATA_API=https://data.europa.eu/api/hub/search/datasets

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
